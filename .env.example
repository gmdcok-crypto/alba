# 로컬은 DB 변수를 비워두면 SQLite (data/alba.db) 를 씁니다.
# Railway 웹 서비스에는 MySQL 서비스 변수를 참조로 넣습니다. (RAILWAY.md)

# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=alba
# DB_PASSWORD=
# DB_NAME=alba

# Railway MySQL (웹 서비스 Variables — 사설 호스트)
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQL_URL=

API_PORT=8000

# 운영(Railway)에서는 반드시 강한 임의 문자열
# JWT_SECRET=
# KIOSK_QR_SECRET=
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# REFRESH_TOKEN_EXPIRE_DAYS=365
